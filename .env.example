DJANGO_SECRET_KEY=change-this-for-your-machine
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,172.26.210.21
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://172.26.210.21:8000

# Gemini Enterprise / Vertex AI (recommended)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Optional service account key path (otherwise use: gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Optional: Vertex express mode (API key instead of ADC)
# GOOGLE_GENAI_USE_VERTEXAI_EXPRESS=1
# GEMINI_API_KEY=your-vertex-express-api-key

# Legacy fallback: Gemini Developer API / AI Studio free tier
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_API_KEY=your-gemini-api-key

PECKISH_WEB_IMAGES=1
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://172.26.210.21:8000/accounts/google/callback/
